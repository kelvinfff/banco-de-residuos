# Copie para .env e ajuste os valores.
# Banco PostgreSQL. Com `docker compose up db`, ele fica em localhost:5434.
DATABASE_URL="postgresql://bdr:bdr@localhost:5434/banco_residuos?schema=public"
# Segredo usado para assinar os tokens de sessão (mínimo 32 caracteres)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio-123456"
# Porta da API
PORT=3333
# Comissão da plataforma em pontos-base (500 = 5%)
COMISSAO_BPS=500
# Pasta onde as fotos dos anúncios são gravadas
UPLOAD_DIR="./uploads"
