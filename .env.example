# Opcional. Copie para .env para personalizar o `docker compose up`.
# Sem este arquivo, tudo funciona com os valores padrão de demonstração.

# Senha do PostgreSQL do contêiner
POSTGRES_PASSWORD=bdr

# Portas publicadas na sua máquina
WEB_PORT=3000
DB_PORT=5434

# Segredo das sessões. Vazio = gerado automaticamente na primeira execução.
JWT_SECRET=

# Comissão da plataforma em pontos-base (500 = 5%)
COMISSAO_BPS=500

# "false" para subir com o banco vazio, sem os dados de demonstração
SEED=true
